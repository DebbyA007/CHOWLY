# Neon PostgreSQL. DATABASE_URL is the pooled string, DIRECT_URL the direct one (migrations).
DATABASE_URL=""
DIRECT_URL=""

# Signs the customer session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=""

# Staff PIN for waiter mutations. Compared with crypto.timingSafeEqual. Six digits.
STAFF_PIN=""

# Authorization seam for waiter routes. Only the exact value false opens them; absent or
# anything else keeps the server-side PIN check on. Set false for the demo deployment.
STAFF_PIN_REQUIRED="false"
