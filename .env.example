# Neon PostgreSQL. DATABASE_URL is the pooled string, DIRECT_URL the direct one (migrations).
# On a developer's machine these point at the development branch, never at production.
# docs/DATABASE.md has the steps for creating that branch and what to paste where.
DATABASE_URL=""
DIRECT_URL=""

# The host of the database the live link reads, pooled or direct, either matches. Anything
# destructive refuses to run against it. Not a secret: a hostname, not a credential.
# Leave it empty and nothing is guarded, which the commands say out loud when they start.
PRODUCTION_DB_HOST=""

# Signs the customer session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=""

# Staff PIN for waiter mutations. Compared with crypto.timingSafeEqual. Six digits.
STAFF_PIN=""

# Authorization seam for waiter routes. Off by default: only the exact value true turns
# the server-side PIN check on; absent, false or anything else leaves them open.
STAFF_PIN_REQUIRED="false"
